# =====================================
# ⚙️ EXEMPLO DE ARQUIVO .ENV
# Copie este arquivo para ".env" e preencha com seus valores reais
# =====================================

# -------------------
# 🗄️ PostgreSQL
# -------------------
POSTGRES_USER=seu_usuario
POSTGRES_PASSWORD=sua_senha
POSTGRES_DB=nome_do_banco
POSTGRES_PORT=5432

# -------------------
# 🧠 pgAdmin
# -------------------
PGADMIN_DEFAULT_EMAIL=seu_email@exemplo.com
PGADMIN_DEFAULT_PASSWORD=sua_senha_pgadmin

# -------------------
# 🪶 Airflow
# -------------------
AIRFLOW_UID=50000
AIRFLOW_USER_USERNAME=usuario_airflow
AIRFLOW_USER_PASSWORD=senha_airflow
AIRFLOW_USER_EMAIL=usuario@exemplo.com

# Conexão com o banco PostgreSQL usado pelo Airflow
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://<usuario>:<senha>@<host>:5432/<banco>

# Configurações adicionais do Airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=coloque_sua_chave_aqui

# -------------------
# 🧱 DBT
# -------------------
DBT_HOST=postgres
DBT_PORT=5432
DBT_USER=usuario_dbt
DBT_PASSWORD=senha_dbt
DBT_DATABASE=nome_do_banco
DBT_PROFILES_DIR=/app/dbt/

# -------------------
# 📊 Streamlit
# -------------------
DATABASE_URL=postgresql+psycopg2://<usuario>:<senha>@<host>:5432/<banco>

# -------------------
# 🪙 CoinGecko API
# -------------------
API_URL=https://api.coingecko.com/api/v3
API_KEY=
REQUEST_TIMEOUT=10
COIN_TOP_N=20

# -------------------
# 📁 Caminhos locais
# -------------------
DATA_DIR=data
LOG_DIR=logs
TIMEZONE=America/Sao_Paulo

# -------------------
# 🐍 Build (Poetry / Containers)
# -------------------
POETRY_VERSION=1.8.2
USER_ID=1000
GROUP_ID=1000
